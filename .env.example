# Wavyzon configuration. Copy this file to .env and fill in what you need.
# Every variable is optional except WAVYZON_PASSWORD. Values shown are the defaults.
# Cadence's CADENCE_* settings are the same names with WAVYZON_*.
# docs/src/configuration.md is the full reference.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Shared secret your bot sends in the Authorization header on every REST and
# WebSocket request. Required. Lavalink's default "youshallnotpass" is refused.
WAVYZON_PASSWORD=

# Address and port to listen on. Point your Lavalink client at this.
WAVYZON_ADDRESS=0.0.0.0:2333

# Log verbosity: debug, info, warn or error. A RUST_LOG filter, when set,
# overrides it (e.g. RUST_LOG=info,wavyzon_voice=debug).
WAVYZON_LOG_LEVEL=info

# Log format: json (one object per line) or pretty (for terminals).
WAVYZON_LOG_FORMAT=json

# Start even when this build cannot do voice (no Opus encoder or no DAVE);
# only search, analysis and the API then work. Off by default: the node
# refuses to start without voice.
WAVYZON_ALLOW_NO_VOICE=false

# Directory for everything Wavyzon writes to disk by default (saved sessions,
# analysis results, plugin data). Created if missing.
WAVYZON_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Sessions and playback
# ---------------------------------------------------------------------------

# How often playerUpdate is sent while a track plays, in milliseconds (minimum 250).
# An update is also sent immediately after every event.
WAVYZON_UPDATE_INTERVAL_MS=1000

# How long players keep playing after your bot disconnects, in seconds, when the
# bot enabled resuming. Reconnect within this window and nothing stops.
WAVYZON_RESUME_TIMEOUT_SECONDS=300

# File where sessions are saved on shutdown, so a Wavyzon restart resumes every
# player where it stopped. Leave empty to start fresh on every restart.
WAVYZON_STATE_FILE=

# Decoded audio buffered ahead per deck, in milliseconds (1000–60000). Larger
# values ride out slow sources better and use more memory per player.
WAVYZON_BUFFER_MS=10000

# Default Opus bitrate in bits per second, used when the bot does not send the
# channel's bitrate. Clamped to 16000–384000.
WAVYZON_BITRATE=96000

# Measured delay between Discord receiving audio and listeners hearing it, in
# milliseconds. It is added to TrackAudibleEvent.audibleAt so synced lyrics land
# on time. Measure it against a recorded client rather than guessing.
WAVYZON_PLAYOUT_DELAY_MS=0

# Fade length for pause and resume, in milliseconds (0 to 2000). A pause fades
# the music out before it stops and a resume fades it back in. 0 turns it off
# and pauses on the next frame.
WAVYZON_PAUSE_FADE_MS=0

# Automatic crossfade into the next track, in milliseconds (0 to 12000). When
# the bot preloads one with nextTrack, it fades in this long before the current
# track ends (equal-power, like Tidal or Spotify). Streams and tracks shorter
# than twice the fade keep the gapless swap. 0 turns it off: strict gapless.
WAVYZON_CROSSFADE_MS=3000

# Level every track to the same loudness using its analysis, so quiet and loud
# masters play at the same volume. Tracks not yet analysed play unchanged.
WAVYZON_NORMALIZE=true

# Loudness target for levelling, in LUFS (−30 to −5). −14 matches most streaming services.
WAVYZON_NORMALIZE_LUFS=-14

# ---------------------------------------------------------------------------
# Audio cache
# ---------------------------------------------------------------------------

# Directory for the audio cache. A track played twice within 7 days is saved as
# it plays, so later plays and seeks need no source requests. Empty disables it.
WAVYZON_AUDIO_CACHE_DIR=

# Maximum cache size in gigabytes (1–1000). Least recently played tracks go first.
WAVYZON_AUDIO_CACHE_GB=20

# Other Wavyzon nodes to share the disk cache with, comma-separated base URLs
# (e.g. https://eu.example:2334). Each node gossips which tracks it has cached;
# on a local miss a node pulls the track from a peer in the background, so a
# track one region fetched serves the other without a second source request.
# It never blocks or slows playback. Needs WAVYZON_AUDIO_CACHE_DIR set,
# WAVYZON_CACHE_SECRET below, and each node reachable from the others on its
# port. Empty disables it.
WAVYZON_CACHE_PEERS=

# Shared secret authenticating the peer cache endpoints between nodes. Must be
# identical on every node, and is independent of WAVYZON_PASSWORD so the nodes
# can keep different passwords. Required for WAVYZON_CACHE_PEERS to take effect.
WAVYZON_CACHE_SECRET=

# ---------------------------------------------------------------------------
# Search and sources
# ---------------------------------------------------------------------------

# Which catalogs plain-text searches query, in order. Apple Music, Spotify and
# Deezer provide metadata; Deezer also streams when it is configured below.
# Results are matched to a track on one of the playback sources below.
WAVYZON_SEARCH_ORDER=deezer,applemusic,spotify,soundcloud

# Sources that actually stream audio and can be searched, in order of
# preference when a metadata result is matched to a playable track. Playable
# plugin sources not listed are tried after these. (http and local play their
# own links but cannot be searched, so they are not mirror targets.)
WAVYZON_PLAYBACK_SOURCES=deezer,soundcloud

# Preload the first result of every loadtracks call, so "search, then play"
# starts from memory.
WAVYZON_PREFETCH_ON_LOAD=true

# Offline track analysis (tempo, key, loudness, structure) used for automix and
# levelling: how many tracks are analysed at once, and how many may wait.
# Work beyond the queue limit is dropped and analysed on a later request instead.
WAVYZON_ANALYSIS_WORKERS=2
WAVYZON_ANALYSIS_QUEUE=32

# --- HTTP source: direct audio URLs and Icecast / Shoutcast streams ---

# Play http:// and https:// links to audio files and internet radio streams.
WAVYZON_HTTP_SOURCE=true

# Allow the HTTP source to fetch private, loopback and link-local addresses
# (10.0.0.0/8, 192.168.0.0/16, 127.0.0.1, ::1, ...). Keep false unless every
# client that knows WAVYZON_PASSWORD is trusted, or the node can be used to
# reach your internal network.
WAVYZON_HTTP_ALLOW_PRIVATE=false

# Redirects followed, request timeout, and an optional proxy for the HTTP source.
WAVYZON_HTTP_MAX_REDIRECTS=5
WAVYZON_HTTP_TIMEOUT_MS=10000
WAVYZON_HTTP_PROXY=

# --- Local files ---

# Directory local tracks may be played from. Paths outside it are refused.
# Empty disables local file playback.
WAVYZON_LOCAL_ROOT=

# --- Deezer (catalog and streaming) ---

DEEZER_ENABLED=true

# Deezer account ARL cookies, comma-separated (the `arl` cookie value of a
# logged-in account). Without one Deezer is metadata only and its tracks are
# mirrored to another playback source. Several ARLs are rotated (see
# DEEZER_ARL_ROTATION); a rejected ARL is benched for 15 minutes.
DEEZER_ARL=

# How several ARLs are used: failover (always the first healthy one),
# round-robin or random. An unknown value is refused at startup.
DEEZER_ARL_ROTATION=failover

# The 16-byte Blowfish master key used to decrypt Deezer streams. Required for
# playback: without it nothing can be decrypted. Wavyzon does not ship one.
DEEZER_MASTER_KEY=

# Ask for 128 kbit/s MP3 (falling back to 64) instead of 64 kbit/s only.
DEEZER_HIGH_QUALITY=true

# Optional HTTP proxy for Deezer requests, e.g. http://user:pass@host:port.
# If the proxy fails, Wavyzon goes direct for 60 seconds and then tries it again.
DEEZER_PROXY=

# --- Spotify (metadata and search only) ---

# Spotify Web API app credentials. Used to resolve Spotify links and searches to
# a playable track by ISRC. Without them Spotify links do not resolve.
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PROXY=

# --- Apple Music (metadata and search only) ---

APPLE_MUSIC_ENABLED=true

# Optional fixed developer token. Leave empty and Wavyzon fetches one itself.
APPLE_MUSIC_TOKEN=

# Two-letter catalog storefront to search, e.g. us, gb, de.
APPLE_MUSIC_STOREFRONT=us
APPLE_MUSIC_PROXY=

# --- SoundCloud ---

# Play from SoundCloud.
SOUNDCLOUD_ENABLED=true

# Optional fixed client id. Leave empty and Wavyzon fetches one itself.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_PROXY=

# --- Lyrics ---

# Serve lyrics from lyrics.ovh on /v1/lyrics and /v4/lyrics (LavaLyrics API).
LYRICS_ENABLED=true
# lyrics.ovh API base; change it only for a mirror.
LYRICS_API_URL=https://api.lyrics.ovh/v1
LYRICS_PROXY=

# ---------------------------------------------------------------------------
# Plugins
# ---------------------------------------------------------------------------

# Plugins to enable, comma-separated by name, in registration order. Empty
# enables every plugin compiled into the binary (cargo features; the default
# build has "example", "apo" and "flowery"). A name that is not compiled in stops the node
# at startup.
WAVYZON_PLUGINS=

# "apo" plugin: directory of Equalizer APO presets (.txt) and impulse responses
# (wav/flac/ogg), usable as {"pluginFilters": {"apo": {"preset": "<name>"}}}.
# Empty = $WAVYZON_DATA_DIR/plugins/apo. Reload with POST /v1/plugins/apo/reload.
WAVYZON_PLUGIN_APO_DIR=

# "flowery" plugin: Flowery text-to-speech as ftts://<text>?voice=... (LavaSrc's
# identifiers; /v4/info lists "ftts" and "flowery-tts"). On by default, no API key.
# false = no ftts source (or leave "flowery" out of WAVYZON_PLUGINS).
WAVYZON_PLUGIN_FLOWERY_ENABLED=true
# Defaults for options an identifier does not give. Empty voice = Flowery's default
# (ids and names: https://api.flowery.pw/v1/tts/voices). Silence 0-10000 ms,
# speed 0.5-10, format mp3, ogg_vorbis, aac, wav or flac.
WAVYZON_PLUGIN_FLOWERY_VOICE=
WAVYZON_PLUGIN_FLOWERY_TRANSLATE=false
WAVYZON_PLUGIN_FLOWERY_SILENCE=0
WAVYZON_PLUGIN_FLOWERY_SPEED=1.0
WAVYZON_PLUGIN_FLOWERY_AUDIO_FORMAT=mp3
WAVYZON_PLUGIN_FLOWERY_TIMEOUT_MS=30000
WAVYZON_PLUGIN_FLOWERY_PROXY=

# Plugin settings are read from WAVYZON_PLUGIN_<NAME>_<KEY>, where <NAME> is the
# plugin name and <KEY> the setting, both upper-cased with '-' turned into '_'.
# For example, a plugin named "hello" with a "greeting" setting:
# WAVYZON_PLUGIN_HELLO_GREETING=Hello from Wavyzon
